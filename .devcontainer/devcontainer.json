{
  "name": "Java 17 + Maven",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "distribution": "tem",
      "installMaven": true,
      "mavenVersion": "3.9.9"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven"
      ],
      "settings": {
        "java.jdt.ls.java.home": "${env:JAVA_HOME}",
        "maven.terminal.useJavaHome": true
      }
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "git lfs install && java -version && mvn -v && git lfs version"
}






